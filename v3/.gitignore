# No trailing slash: matches the dir AND a node_modules symlink (WorktreeManager
# provisions node_modules into worktrees as a symlink; a trailing-slash pattern
# matches directories only, so the link would otherwise pollute git status).
node_modules
dist/
dist-electron/
# Bundled MCP server output — regenerated by `build:mcp` (predev/prebuild hooks)
# and freshly rebuilt at package time, so it must not be committed. Tracking it
# made every dev/build churn it and block `git pull` (needs stash). Sibling of
# dist/ and dist-electron/ above — same rationale.
dist-mcp/
# Cloud Functions tsc output — regenerated by firebase.json predeploy (`tsc`)
# before every deploy; same commit-churn-blocks-pull problem as dist-mcp.
functions/lib/
release/
.vite/
*.log
.env
.env.local
.env.production
# Firebase Functions v2 dotenv — per-project secrets, never commit
.env.marblo-2253d
.env.*.local

# Packaged-app OAuth config (build-time extract of the 2 Google OAuth values
# from .env, ticket QvaYPAjAW822I0IDiwwZ). Contains a secret — never commit.
build-resources/

# Claude Code local settings
.claude/settings.local.json

# Playwright
test-results/
playwright-report/
playwright/.cache/

# OAuth client secret JSON (never commit)
keys/
