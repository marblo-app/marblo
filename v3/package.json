{
  "name": "marblo-v3",
  "version": "3.0.35",
  "description": "Marblo v3.0 - Desktop App",
  "repository": {
    "type": "git",
    "url": "https://github.com/melocream/marblo.git"
  },
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "predev": "npm run build:mcp && npm run assets:pyodide:soft",
    "dev": "tsc -p electron/tsconfig.json && node scripts/bundle-preload.mjs development && concurrently -k \"vite\" \"tsc -p electron/tsconfig.json --watch\" \"node scripts/dev-electron.mjs\"",
    "predev:vite": "npm run assets:pyodide:soft",
    "dev:vite": "vite",
    "predev:electron": "npm run build:mcp && npm run assets:pyodide:soft",
    "dev:electron": "tsc -p electron/tsconfig.json && node scripts/bundle-preload.mjs development && electron .",
    "prebuild": "npm run build:mcp",
    "build": "tsc -p electron/tsconfig.json && node scripts/bundle-preload.mjs && node scripts/check-firebase-env.mjs && vite build",
    "prebuild:electron": "npm run build:mcp",
    "build:electron": "tsc -p electron/tsconfig.json && node scripts/bundle-preload.mjs && node scripts/check-firebase-env.mjs && npm run assets:pyodide && vite build && node scripts/write-oauth-config.mjs && node scripts/write-firebase-config.mjs",
    "build:mac": "npm run build:electron && electron-builder --mac",
    "build:win": "npm run build:electron && electron-builder --win",
    "build:linux": "npm run build:electron && electron-builder --linux",
    "build:all": "npm run build:electron && electron-builder --mac --win --linux",
    "build:electron:dogfood": "VITE_FIRST_PARTY_TELEMETRY=1 npm run build:electron",
    "build:mac:dogfood": "VITE_FIRST_PARTY_TELEMETRY=1 npm run build:mac",
    "build:win:dogfood": "VITE_FIRST_PARTY_TELEMETRY=1 npm run build:win",
    "build:linux:dogfood": "VITE_FIRST_PARTY_TELEMETRY=1 npm run build:linux",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build:mcp": "tsc -p electron/mcp-server/tsconfig.json && node scripts/bundle-mcp.mjs && node scripts/write-mcp-pkg.mjs",
    "mcp": "node dist-mcp/index.js",
    "backfill:project-members": "node scripts/backfill-project-members.mjs",
    "stars:collect": "node scripts/collect-registry-stars.mjs",
    "stars:check": "node scripts/collect-registry-stars.mjs --check",
    "relock": "bash scripts/relock.sh",
    "sync": "bash scripts/sync-and-rebuild.sh",
    "assets:pyodide": "node scripts/fetch-pyodide-assets.mjs",
    "assets:pyodide:soft": "node scripts/fetch-pyodide-assets.mjs --soft",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pty-leak": "tsc -p electron/tsconfig.json && node --expose-gc tests/integration/pty-fd-leak.cjs",
    "test:probe-noninvasive": "tsc -p electron/tsconfig.json && node tests/integration/probe-noninvasive.cjs",
    "test:answer-delivery": "tsc -p electron/tsconfig.json && node tests/integration/answer-delivery-composer.cjs",
    "smoke:packaged:mac": "node scripts/smoke-packaged-app.mjs",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.mjs\"",
    "cost:axis-check": "tsc -p electron/tsconfig.json && node dist-electron/scripts/check-cost-axis-continuity.js",
    "worktree:reap": "tsc -p electron/tsconfig.json && node dist-electron/scripts/reap-worktrees.js",
    "worktree:merged-reap": "tsc -p electron/tsconfig.json && node dist-electron/scripts/merged-worktree-reap.js",
    "graph:seed": "tsc -p electron/tsconfig.json && node dist-electron/scripts/seed-routing-graph.js",
    "verify:models": "tsc -p electron/tsconfig.json && node dist-electron/scripts/verify-models.js",
    "bench:swe": "tsc -p electron/tsconfig.json && node dist-electron/scripts/bench/run.js",
    "bench:swe:vendor": "tsc -p electron/tsconfig.json && electron dist-electron/scripts/bench/secret-launcher.js --secret=UPSTAGE_API_KEY -- node dist-electron/scripts/bench/run.js",
    "bench:swe:vendor:deepseek": "tsc -p electron/tsconfig.json && electron dist-electron/scripts/bench/secret-launcher.js --secret=DEEPSEEK_API_KEY -- node dist-electron/scripts/bench/run.js",
    "bench:swe:report": "tsc -p electron/tsconfig.json && node dist-electron/scripts/bench/report.js",
    "bench:swe:emit": "tsc -p electron/tsconfig.json && node dist-electron/scripts/bench/report.js --out=docs/benchmark/generated-report.md --emit-ours=electron/model-bench-ours-data.ts",
    "test:e2e:pw": "playwright test",
    "test:e2e:pw:ui": "playwright test --ui",
    "test:e2e:pw:headed": "playwright test --headed",
    "test:e2e:pw:debug": "PWDEBUG=1 playwright test",
    "test:e2e:pw:report": "playwright show-report",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@monaco-editor/react": "^4.7.0",
    "@sentry/electron": "^7.15.0",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.10.1",
    "chokidar": "^5.0.0",
    "dotenv": "^17.4.1",
    "electron-updater": "^6.8.3",
    "firebase": "^10.14.1",
    "gifenc": "^1.0.3",
    "lucide-react": "^1.16.0",
    "mediabunny": "^1.52.2",
    "node-pty": "^1.0.0",
    "openai": "^6.32.0",
    "prettier": "^3.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^19.2.5",
    "react-markdown": "^9.1.0",
    "recharts": "^3.8.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "simple-git": "^3.33.0",
    "ws": "^8.21.1",
    "yaml": "^2.9.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@electron/rebuild": "^3.6.0",
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^3.0.3",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.6.0",
    "jsdom": "^24.1.3",
    "monaco-editor": "^0.52.2",
    "postcss": "^8.4.49",
    "pyodide": "^314.0.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^6.0.7",
    "vitest": "^4.1.0"
  },
  "build": {
    "extends": "electron-builder.yml"
  },
  "overrides": {
    "@electron/osx-sign": {
      "isbinaryfile": "^5.0.4"
    }
  }
}
