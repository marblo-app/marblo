# ================================
# Backend Environment Variables
# ================================

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/marblo

# BigQuery Configuration
GOOGLE_CLOUD_PROJECT=your-project-id
BIGQUERY_DATASET_ID=marblo_data

# Coupang Wing Partners API
COUPANG_ACCESS_KEY=your-access-key
COUPANG_SECRET_KEY=your-secret-key
COUPANG_VENDOR_ID=your-vendor-id
COUPANG_BASE_URL=https://api-gateway.coupang.com

# Naver SmartStore API
NAVER_CLIENT_ID=your-client-id
NAVER_CLIENT_SECRET=your-client-secret
NAVER_REDIRECT_URI=http://localhost:8001/callback/naver
NAVER_ACCESS_TOKEN=your-access-token
NAVER_REFRESH_TOKEN=your-refresh-token

# API Server
API_HOST=0.0.0.0
API_PORT=8001
API_RELOAD=true
API_DEBUG=true

# Security
SECRET_KEY=your-secret-key-for-jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
CORS_ORIGINS=["http://localhost:3001"]

# Logging
LOG_LEVEL=INFO
LOG_FILE=backend.log

# Sync Schedule (cron format)
COUPANG_SYNC_SCHEDULE="0 */6 * * *"  # Every 6 hours
NAVER_SYNC_SCHEDULE="0 */6 * * *"    # Every 6 hours

# Redis (for caching and task queue)
REDIS_URL=redis://localhost:6379/0

# Celery (for background tasks)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2