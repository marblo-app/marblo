rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Helper Functions =====

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getProject(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }

    function taskExists(taskId) {
      return exists(/databases/$(database)/documents/tasks/$(taskId));
    }

    function getTask(taskId) {
      return get(/databases/$(database)/documents/tasks/$(taskId)).data;
    }

    function isProjectMember(projectId) {
      let project = getProject(projectId);
      return request.auth.uid in project.get('members', [])
        || request.auth.uid == project.ownerId;
    }

    function isTaskProjectMember(taskId) {
      return taskExists(taskId) && isProjectMember(getTask(taskId).projectId);
    }

    function isProjectOwner(projectId) {
      return request.auth.uid == getProject(projectId).ownerId;
    }

    function getMemberRoleDoc(projectId, userId) {
      return get(/databases/$(database)/documents/memberRoles/$(projectId + '_' + userId)).data;
    }

    function memberRoleExists(projectId, userId) {
      return exists(/databases/$(database)/documents/memberRoles/$(projectId + '_' + userId));
    }

    function getMemberRole(projectId, userId) {
      return memberRoleExists(projectId, userId)
        ? getMemberRoleDoc(projectId, userId).role
        : 'member';
    }

    function isAdminOrOwner(projectId) {
      return isProjectOwner(projectId)
        || (memberRoleExists(projectId, request.auth.uid)
            && getMemberRoleDoc(projectId, request.auth.uid).role == 'admin');
    }

    function isPlatformAdmin() {
      return isAuthenticated()
        && (request.auth.token.admin == true
            || request.auth.token.role == 'admin'
            || request.auth.token.marbloRole == 'admin');
    }

    // 원장 계열(audit_logs / merge_history / telemetry_events) 공통 read 게이트.
    //
    // 이전엔 세 컬렉션 모두 `allow read: if isAuthenticated()` 라 로그인한 누구나
    // projectId 만 알면 타 테넌트의 감사 기록·머지 이력·텔레메트리를 통째로
    // 읽었다(다른 컬렉션은 전부 isProjectMember 로 스코프돼 있었는데 이 셋만
    // 빠져 있었다). L2 는 이 구멍을 닫는다.
    //
    // ★projectId == "" 예외 — 유실 가시성 보존:
    //   ledger-spool.ts 의 오버플로 tombstone / 미해결 lifecycle 마커는 귀속할
    //   prior 이벤트가 없을 때 projectId="" 로 생성된다(ledger-spool.ts:577,837).
    //   이건 "감사 이벤트가 유실됐다"를 기록하는 레코드 자체다. isProjectMember("")
    //   는 영원히 false 이므로 멤버 스코프로만 조이면 **유실의 기록이 다시 유실된다**
    //   — 원장의 핵심(유실 가시성)이 깨진다.
    //   → projectId="" 레코드는 특정 프로젝트에 귀속되지 않으므로 프로젝트 멤버가
    //     아니라 **플랫폼 admin** 만 읽게 한다. 크로스테넌트는 여전히 닫혀 있고
    //     (일반 사용자는 못 읽음), 유실은 admin 헬스뷰에서 조회 가능하다.
    //   MCP 서버(에이전트)는 admin 이 아니라 이 tombstone 을 못 읽지만, 그건
    //   의도된 동작이다: tools.ts verifyLedgerRecord 가 permission-denied 를
    //   null(미상)로 받아 park 처리하므로 스풀이 고착하지 않는다.
    //
    // .get('projectId', '') 로 필드 부재(구 레코드)도 ""(admin-only)로 안전 처리한다.
    function canReadLedgerDoc() {
      return isAuthenticated()
        && (
          (resource.data.get('projectId', '') != ''
            && isProjectMember(resource.data.projectId))
          || (resource.data.get('projectId', '') == ''
            && isPlatformAdmin())
        );
    }

    // 프로젝트 귀속 문서의 공통 read 게이트 — 테넌트 경계 (티켓 Ciriq5ASEvAlA8TnKxhW).
    //
    // canReadLedgerDoc() 과 **일부러 다르다**: 저쪽은 projectId=="" 를 플랫폼
    // admin 에게 연다. 그 예외는 "감사 이벤트가 유실됐다"는 기록 자체를 살리기
    // 위한 것이라, 유실 가시성 요구가 없는 컬렉션에 그대로 복사하면 admin 을
    // 만능 백도어로 넓히기만 한다. 그래서 여기는 예외 없이 fail-closed 다 —
    // 귀속할 테넌트가 없는 문서(projectId 부재/공백)는 아무도 못 읽는다.
    //
    // .get('projectId', '') 로 필드 부재(구/손상 문서)도 ""(=거부)로 처리한다.
    function canReadProjectScopedDoc() {
      return isAuthenticated()
        && resource.data.get('projectId', '') != ''
        && isProjectMember(resource.data.projectId);
    }

    // ===== Users =====
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if false;
    }

    // ===== Projects =====
    // 플랜별 프로젝트 수 한도(Free=1) 서버 방어:
    //   Firestore 규칙은 소유자의 기존 프로젝트 개수를 셀 수 없으므로(집계 불가),
    //   개수 한도는 functions 의 onCreate 트리거 `enforceProjectLimit` 가 강제한다
    //   — Free 소유자가 2번째+ 프로젝트를 직접 write 로 만들면 즉시 삭제된다.
    //   여기서는 소유자/멤버 무결성만 검사한다(우회 write 도 ownerId 위조는 불가).

    // B2: 초대 수락 self-join 의 근거가 되는 초대 문서 검증.
    // 룰은 컬렉션 쿼리가 불가하므로 초대 문서를 결정적 ID
    // ({projectId}_{소문자 이메일}, teamService.invitationDocId 와 동일 규약)로
    // get 한다. 문서가 없으면 get 이 에러 → 전체 조건이 거부로 떨어진다.
    function hasValidPendingInvite(projectId) {
      let inv = get(/databases/$(database)/documents/invitations/$(projectId + '_' + request.auth.token.email.lower())).data;
      return inv.projectId == projectId
        && inv.invitedEmail.lower() == request.auth.token.email.lower()
        && inv.status == 'pending'
        && request.time < inv.expiresAt;
    }

    // B2: 아직 멤버가 아닌 초대 대상자가 "자신의 uid 만" members 에 추가하는
    // 단일 전이. 함께 금지되는 것:
    //  - members/updatedAt 외 필드 변경(ownerId·name 위조 차단)
    //  - 타인 uid 추가(hasOnly: 결과가 기존 ∪ {본인}을 벗어날 수 없음)
    //  - 기존 멤버 제거(hasAll: 기존 멤버 전원이 결과에 남아야 함)
    // arrayUnion 재시도(이미 멤버)는 no-op 으로 통과해 멱등 수락이 성립한다.
    function isInvitedSelfJoin(projectId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.hasOnly(resource.data.members.concat([request.auth.uid]))
        && request.auth.uid in request.resource.data.members
        && hasValidPendingInvite(projectId);
    }

    // ===== projects 필드별 쓰기 권한 (티켓 wWl44fSBwmQ4vRylmHsF, P1) =====
    //
    // 이전엔 update 게이트가 `isProjectMember` 하나뿐이라 **멤버 누구나 프로젝트
    // 문서의 아무 필드나** 쓸 수 있었다. 지금 당장은 메타 변조(name/ownerId
    // 위조 시도)지만, 진짜 문제는 앞으로 들어올 필드다: GitHub App 설계가
    // `githubInstallationId` 를 프로젝트 문서에 두는 걸 전제하는데, 그 상태로
    // 필드가 추가되면 **프로젝트 A 의 멤버가 그 필드를 써넣어 B 의 private repo
    // 에 접근하는 크로스테넌트 권한 상승**이 성립한다.
    //
    // ★그래서 denylist 가 아니라 allowlist 다. denylist 는 "새로 생기는 필드가
    //   기본 허용"이라 이 사고를 다시 만든다. allowlist 는 **새 필드가 기본
    //   차단**이므로, githubInstallationId 같은 서버 전용 필드를 규칙 수정 없이
    //   추가해도 클라이언트는 처음부터 못 쓴다.
    //
    // 목록은 추측이 아니라 전수 census 로 만들었다 — 이 앱에서 projects 문서를
    // 쓰는 코드는 아래가 전부다(admin SDK 경로인 functions/scripts 는 규칙을
    // 우회하므로 제외; functions 는 project 문서에 필드를 쓰지 않고 읽기/삭제만
    // 한다).
    //
    //   MEMBER (일반 멤버가 정당하게 쓰는 필드)
    //     folderPath        projectService.createProject (신규 등록 시 1회)
    //     folderPaths       projectService.setProjectFolderPathForMachine
    //                       (기기별 경로 칸, merge 쓰기)
    //     gitRemoteUrl      RepoConnectModal.backfillRepoUrl /
    //                       useProjectSetup(기존 프로젝트 backfill) /
    //                       teamService.backfillProjectRepoUrl /
    //                       teamService.propagateInvitationRepoUrl
    //     telegramChannel   electron/telegram-channel-sync.writeChannelMeta
    //     enabledModels     Project 타입 필드(현재 영속 쓰기 경로 없음, 디스패치
    //                       설정이라 멤버 티어 유지)
    //     legacyFolderPath / folderPathResolution
    //                       스토어가 클라이언트에서 파생시키는 값. 영속 쓰기
    //                       경로는 없지만 Project 객체를 그대로 updateProject 에
    //                       넘기는 코드가 생겨도 깨지지 않도록 열어 둔다
    //                       (보안 가치 없음 = 열어도 무해).
    //     updatedAt         projectService 의 모든 쓰기가 함께 싣는다.
    //
    //   ADMIN/OWNER (owner 또는 memberRoles.role == 'admin' 만)
    //     name              생성 시점 외 쓰기 경로 없음. 프로젝트 정체성이라
    //                       관리자 티어.
    //     kind              생성 시점 외 쓰기 경로 없음(dev/assistant 전환은
    //                       워크스페이스 성격 자체를 바꾼다).
    //     members           UI 게이트와 동일 판정 — TeamManagement 의
    //                       manage_members 권한이 owner/admin 뿐이다
    //                       (types/invitation.ts ROLE_PERMISSIONS).
    //                       초대 수락 self-join 은 아래 isInvitedSelfJoin 분기가
    //                       따로 처리하므로 이 제한에 걸리지 않는다.
    //
    //   서버 전용 / 불변 (클라이언트 write 전면 차단 — 위 목록에 없는 전부)
    //     ownerId           소유권 이전 기능이 없다. 위조 차단.
    //     createdAt         생성 후 갱신 경로 없음.
    //     assistantTriggers ★census 결과 이 앱에는 **쓰기 경로가 아예 없다** —
    //                       electron/main.ts listAssistantTriggerProjects 와
    //                       electron/assistant-triggers.ts 가 읽기만 한다.
    //                       이 값은 트리거로 오케스트레이터를 깨우는 실행 스위치라
    //                       (main.ts ensureAssistantTriggerOrchestrator) 멤버가
    //                       임의로 켜면 남의 기기에서 에이전트가 돌아간다.
    //                       쓰는 코드가 없으므로 막아도 회귀가 없고, 콘솔·서버는
    //                       Admin SDK 라 규칙을 우회해 그대로 설정할 수 있다.
    //                       → 서버 전용으로 둔다.
    //     githubInstallationId 및 향후 서버 관리 필드
    //                       ★App 설계의 전제. allowlist 이므로 필드를 추가하는
    //                       것만으로 클라이언트 write 가 막혀 있다.
    function projectMemberWritableFields() {
      return [
        'folderPath', 'folderPaths', 'legacyFolderPath', 'folderPathResolution',
        'gitRemoteUrl', 'telegramChannel', 'enabledModels', 'updatedAt'
      ];
    }

    function projectAdminWritableFields() {
      return projectMemberWritableFields().concat(['name', 'kind', 'members']);
    }

    // create 시 허용 키. update 와 달리 문서 전체 키를 본다.
    // ownerId/createdAt 은 여기서만 쓸 수 있고(그래서 update 에서는 불변),
    // 그 외 서버 전용 필드는 **생성 시점에도** 심을 수 없다 — 신규 프로젝트에
    // 남의 githubInstallationId 를 박아 넣는 우회로를 함께 닫는다.
    function projectCreatableFields() {
      return projectAdminWritableFields().concat(['ownerId', 'createdAt']);
    }

    function projectUpdateKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated()
        && (request.auth.uid in resource.data.get('members', [])
            || request.auth.uid == resource.data.ownerId);
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.members
        && request.resource.data.keys().hasOnly(projectCreatableFields());
      // 멤버 필드만 바뀌면 memberRoles 조회 없이 통과한다(추가 get 비용 회피).
      // 관리자 전용 필드가 섞이면 그때만 역할을 확인한다.
      allow update: if isAuthenticated()
        && (
          (isProjectMember(projectId)
            && (projectUpdateKeys().hasOnly(projectMemberWritableFields())
                || (projectUpdateKeys().hasOnly(projectAdminWritableFields())
                    && isAdminOrOwner(projectId))))
          || isInvitedSelfJoin(projectId)
        );
      allow delete: if isAuthenticated() && isProjectOwner(projectId);
    }

    // ===== Tasks =====
    // 크로스테넌트 누출 차단: renderer, Electron main, MCP 서버 모두 실제 사용자
    // uid 로 인증한 뒤 자기 프로젝트 task 만 읽고 쓸 수 있다.
    //
    // ★★쿼리(list) 규율 — 읽기 전에 반드시 알아야 하는 것 (티켓 4ov5wbQZ25XUXHZVhxdh):
    //   아래 read 룰은 `resource.data.projectId` 를 참조한다. 단건 get 이면
    //   resource 가 그 문서지만, **list 는 문서를 읽어 보고 판정하지 않는다** —
    //   쿼리 제약식만으로 룰이 증명돼야 한다("security rules are not filters").
    //   그래서 projectId 를 `==` 로 고정하지 않은 tasks 쿼리는 결과가 전부 자기
    //   프로젝트 문서여도 **통째로 거부**된다. 에뮬레이터 원문:
    //     "Property projectId is undefined on object. for 'list'"
    //   클라이언트에는 이게 "Missing or insufficient permissions" 로만 보이므로
    //   룰 드리프트/토큰 만료로 오인하기 쉽다. 실제로 그렇게 오인된 P1 이 있었다:
    //   applyProjection 이 미션 statusCounts seed 를 위해 무스코프 쿼리를 쏘고,
    //   그게 거부되며 update_task_status/add_activity 의 상태 write 가 시작도
    //   못 하고 실패했다(agents/flows/chatMessages/taskComments/pendingInstructions
    //   /audit_logs/merge_history 도 같은 룰 모양 = 같은 규율).
    //   코드 쪽 단일 규율: electron/mcp-server/project-scope.ts
    //   회귀 가드: firestore.rules.test.ts "프로젝트 스코프 쿼리 규율" +
    //              tests/unit/project-scoped-query-guard.test.ts (소스 스캔)

    // 머지성 write 게이트: REVIEW→DONE 전이는 "리뷰 통과 후 머지 완료 처리"다
    // (renderer 의 merged→DONE 화해 shouldMarkMergedTaskDone 이 허용하는 유일한
    // 전이). 코드 머지는 관리자(owner/admin)만 — member 는 REVIEW 제출까지.
    // 상태머신 전체를 룰로 강제하진 않는다(다단 우회 차단은 전이 그래프 전체가
    // 필요) — 핵심 머지 전이만 룰로 잠그고 1차 게이트는 UI/렌더러가 맡는다.
    function isMergeCloseoutTransition() {
      return resource.data.get('status', '') == 'REVIEW'
        && request.resource.data.get('status', '') == 'DONE';
    }

    match /tasks/{taskId} {
      allow read: if isAuthenticated()
        && isProjectMember(resource.data.projectId);
      allow create: if isAuthenticated()
        && isProjectMember(request.resource.data.projectId);
      allow update: if isAuthenticated()
        && isProjectMember(resource.data.projectId)
        && request.resource.data.projectId == resource.data.projectId
        && (!isMergeCloseoutTransition()
            || isAdminOrOwner(resource.data.projectId));
      allow delete: if isAuthenticated()
        && isProjectMember(resource.data.projectId);
    }

    // ===== Agents =====
    match /agents/{agentId} {
      allow read: if isAuthenticated()
        && isProjectMember(resource.data.projectId);
      allow create: if isAuthenticated()
        && isProjectMember(request.resource.data.projectId);
      allow update: if isAuthenticated()
        && isProjectMember(resource.data.projectId)
        && request.resource.data.projectId == resource.data.projectId;
      allow delete: if isAuthenticated()
        && isProjectMember(resource.data.projectId);
    }

    // ===== Activities =====
    match /activities/{activityId} {
      allow read: if isAuthenticated()
        && isTaskProjectMember(resource.data.taskId);
      allow create: if isAuthenticated()
        && isTaskProjectMember(request.resource.data.taskId);
      allow update: if false;
      allow delete: if false;
    }

    // ===== Pending Instructions =====
    // Queue of instructions targeted at an agent's PTY on a specific machine.
    // The marblo app on the machine hosting `targetAgentId` listens for
    // undelivered entries (isDelivered == false) and injects them into the
    // PTY's stdin, then flips isDelivered to true.
    match /pendingInstructions/{instId} {
      allow read: if isAuthenticated()
        && isProjectMember(resource.data.projectId);
      allow create: if isAuthenticated()
        && isProjectMember(request.resource.data.projectId)
        && request.resource.data.fromUserId == request.auth.uid;
      // Only the delivery-marking transition is allowed: message and routing
      // fields must remain immutable. This prevents a malicious client from
      // rewriting another user's pending instruction in-flight.
      allow update: if isAuthenticated()
        && isProjectMember(resource.data.projectId)
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.taskId == resource.data.taskId
        && request.resource.data.targetAgentId == resource.data.targetAgentId
        && request.resource.data.message == resource.data.message
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.fromUserName == resource.data.fromUserName
        && request.resource.data.sourceType == resource.data.sourceType
        && request.resource.data.createdAt == resource.data.createdAt
        && resource.data.isDelivered == false
        && request.resource.data.isDelivered == true;
      allow delete: if false;
    }

    // ===== Chat Messages =====
    // 크로스테넌트 누출 차단: 프로젝트 멤버만 자기 프로젝트의 채팅을 읽고 쓸 수 있다.
    // (이전엔 isAuthenticated() 만 검사 → 로그인한 누구나 projectId 만 알면 타 팀
    //  채팅을 열람/주입할 수 있었음.)
    // 작성자 무결성: type=='user' 메시지는 senderId 가 반드시 작성자 본인 uid.
    //  system/agent 메시지는 senderId 가 라벨('system'/agentName)이라 검사 제외.
    // 작성·구독 경로는 렌더러(src/services/chatService.ts, 실 사용자 auth) 뿐이므로
    //  멤버 스코프로 좁혀도 정상 동작한다 (MCP/오케는 이 컬렉션을 건드리지 않음).
    match /chatMessages/{messageId} {
      allow read: if isAuthenticated()
        && isProjectMember(resource.data.projectId);
      allow create: if isAuthenticated()
        && isProjectMember(request.resource.data.projectId)
        && (request.resource.data.type != 'user'
            || request.resource.data.senderId == request.auth.uid);
      allow update: if false;
      allow delete: if false;
    }

    // ===== Task Comments =====
    // 크로스테넌트 누출 차단: 프로젝트 멤버만 자기 프로젝트의 코멘트를 읽고 쓸 수 있다.
    // 작성자 무결성: authorId 는 반드시 작성자 본인 uid (src/services/commentService.ts
    //  addComment 가 user.uid 를 authorId 로 기록).
    match /taskComments/{commentId} {
      allow read: if isAuthenticated()
        && isProjectMember(resource.data.projectId);
      allow create: if isAuthenticated()
        && isProjectMember(request.resource.data.projectId)
        && request.resource.data.authorId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // ===== Flows =====
    match /flows/{flowId} {
      allow read: if isAuthenticated()
        && isProjectMember(resource.data.projectId);
      allow create: if isAuthenticated()
        && isProjectMember(request.resource.data.projectId);
      allow update: if isAuthenticated()
        && isProjectMember(resource.data.projectId)
        && request.resource.data.projectId == resource.data.projectId;
      allow delete: if isAuthenticated()
        && isProjectMember(resource.data.projectId);
    }

    // ===== Missions (Phase 3) =====
    //
    // ★read 테넌트 경계 (티켓 Ciriq5ASEvAlA8TnKxhW):
    //   이전엔 `allow read: if isAuthenticated()` 라 **로그인만 하면 남의 테넌트
    //   미션이 통째로 읽혔다** — 프로젝트 멤버십을 보지도 않았다. 원장 계열은
    //   #L2(#540)에서 닫혔는데 이 컬렉션만 남아 있었다.
    //
    //   여기 있던 "한시 완화" 주석은 MissionEngine 이 main process 에서 **익명
    //   auth** 로 붙기 때문에 멤버 스코프를 걸면 죽는다는 것이었고, 해소 계획으로
    //   ①렌더러가 id 토큰을 IPC 로 전달 ②main 이 signInWithCustomToken 으로 교체
    //   를 적어 뒀다. ★그 ①②는 이미 구현돼 있다 — 주석만 남아 있었다:
    //     - electron/mission-engine/firebase-app.ts : MARBLO_FIREBASE_CUSTOM_TOKEN
    //       우선, 없을 때만 익명 베이스라인
    //     - electron/firebase-auth-sync.ts syncAgentCustomToken ← main.ts IPC
    //       ← AuthProvider 가 로그인·onAuthStateChanged·onIdTokenChanged 마다
    //       재동기화(재시도 포함)
    //     - electron/mcp-server/firebase.ts : 익명 폴백을 아예 하지 않는다
    //   남는 익명 창은 "로그인 전" 뿐이고, 그 구간엔 정당하게 읽을 프로젝트
    //   데이터가 없다. 그래서 완화를 유지할 근거가 없어졌다.
    //
    // ★list(쿼리) 주의 — 읽는 쪽이 반드시 지켜야 하는 규율:
    //   Firestore 는 list 를 문서가 아니라 **쿼리 제약식**으로 판정한다
    //   ("security rules are not filters"). projectId 동등조건이 없는 쿼리는
    //   결과가 전부 내 프로젝트 문서여도 통째로 거부된다. 그래서 missions 를
    //   electron/mcp-server/project-scope.ts 의 PROJECT_SCOPED_COLLECTIONS 에
    //   함께 등록했다. 무스코프 쿼리를 쏘던 mission-engine 경로
    //   (wire.ts / event-forwarder.ts)는 프로젝트별로 쪼개 발사한다.
    //
    // ★쓰기 테넌트 경계 (티켓 tGQ2c13YNalM5rqRetOE) — **이제 read/write 전부 닫혔다.**
    //
    //   #1113(위 read 항목)은 읽기만 닫았고 쓰기 세 축은 `isAuthenticated()` 로
    //   남겨 뒀다. 즉 **로그인만 하면 남의 테넌트 미션을 update/delete 할 수 있었다.**
    //   읽기 유출보다 나쁜 축이다 — 유출은 되돌릴 수 있지만 삭제는 못 되돌린다.
    //   이 티켓이 그 셋을 flows 블록과 같은 관용구로 조인다.
    //
    // ★delete 를 `if false` 로 잠그지 못한 이유 — 실측:
    //   "앱이 안 쓰면 if false 가 가장 싼 잠금"이라는 가설로 시작했는데
    //   **미션 삭제는 실사용 경로다**:
    //     - src/components/tabs/MissionsTab.tsx:268 handleDelete (미션 영구 삭제)
    //     - src/components/tabs/MissionsTab.tsx:301 handleClearArchive (아카이브 일괄)
    //     → src/services/missionService.ts:111 deleteMission
    //   조사 없이 잠갔으면 미션탭의 삭제·아카이브 정리가 통째로 죽었다. 그래서
    //   "차단"이 아니라 "멤버로 제한"이 정답이다.
    //
    // ★조여도 안 깨지는 근거 — 쓰기 경로 전수 조사(주체 3):
    //   [렌더러·실사용자 auth] MissionsTab.tsx:145/235 create(projectId 명시),
    //     missionService.ts:106 updateDoc, :160/:193 txn.update, :268/:301 delete
    //   [main/mission-engine·custom token] store-impl.ts:155 addDoc(projectId 명시),
    //     :171 updateDoc, dispatcher-impl.ts:81 updateDoc(taskIds)
    //   [MCP 서버·custom token, 익명폴백 없음] tools.ts:1530 addDoc
    //     (implicit-mission.ts:162 이 projectId 를 항상 채운다), :1551 updateDoc,
    //     mcp-server/projection.ts:378 txn.update
    //   [Cloud Functions] index.ts:13554 는 admin SDK **read 전용** — 룰을 우회하며
    //     이 변경의 영향을 받지 않는다.
    //   → create 3곳은 전부 payload 에 projectId 를 넣는다(멤버십 요구 OK).
    //   → update 9곳은 전부 **부분 패치이고 projectId 를 건드리지 않는다**.
    //     updateDoc/txn.update 의 `request.resource.data` 는 "기존 문서 + 패치"의
    //     병합값이라, projectId 핀은 정상 쓰기를 하나도 막지 않고 테넌트 이전
    //     (남의 미션을 내 프로젝트로 끌어오기)만 막는다. 프로덕션에 문서를 통째로
    //     덮는 setDoc 경로는 0건이다.
    //   → 애초에 read 가 #1113 로 이미 멤버 스코프인데 세 주체 모두 정상 동작
    //     중이다 = 같은 isProjectMember 게이트를 쓰기에 걸어도 통과할 수 있는
    //     신원이라는 실측 증거다.
    //
    // ★projectId 부재 문서(구/손상)는 쓰기도 fail-closed 다 — read 와 같은 규율.
    //   `.get('projectId','')` 로 필드 부재를 ""(=거부)로 떨어뜨린다. 그런 문서는
    //   이미 아무도 못 읽으므로, 못 고치는 대신 남이 지울 수도 없게 된다.
    //   (정리가 필요하면 룰을 우회하는 admin SDK 로 한다.)
    //
    // ★남은 것: 없다. read/create/update/delete 네 축 모두 프로젝트 멤버 스코프다.
    //   필드 단위 무결성(예: 남의 projectId 로 create, status 전이 검증)은 이
    //   경계와 별개 층이고, projectId 위조 create 는 아래 create 규칙이 이미 막는다
    //   (자기가 멤버인 프로젝트로만 만들 수 있다).
    match /missions/{missionId} {
      allow read: if canReadProjectScopedDoc();
      allow create: if isAuthenticated()
        && request.resource.data.get('projectId', '') != ''
        && isProjectMember(request.resource.data.projectId);
      allow update: if isAuthenticated()
        && resource.data.get('projectId', '') != ''
        && isProjectMember(resource.data.projectId)
        && request.resource.data.get('projectId', '') == resource.data.projectId;
      allow delete: if isAuthenticated()
        && resource.data.get('projectId', '') != ''
        && isProjectMember(resource.data.projectId);
    }

    // ===== Cost Logs (Phase 3) =====
    //
    // ★read 테넌트 경계 (티켓 Ciriq5ASEvAlA8TnKxhW): missions 와 같은 구멍이었다
    //   — `isAuthenticated()` 만이라 로그인만 하면 남의 테넌트 비용이 읽혔다.
    //
    // ★실측: 이 **Firestore** 컬렉션을 읽거나 쓰는 코드 경로는 현재 0건이다.
    //   코드베이스의 `cost_logs` 는 전부 **BigQuery 테이블**이고
    //   (functions/src/index.ts 의 BQ_COST_TABLE, analytics 계열), 사용량은
    //   렌더러 choke → functions → BigQuery 로 간다. harness-quota.ts 가 말하는
    //   "cost_logs 로컬 거울"도 Firestore 가 아니라 usage-rollup.ts 의 로컬 파일이다.
    //   → 조여도 깨질 정당한 읽기가 없다. 다만 firestore.indexes.json 에
    //     cost_logs(projectId, createdAt) 인덱스가 남아 있어 잔존 문서가 있을 수
    //     있으므로, 그 문서가 로그인만으로 읽히던 것을 닫는다.
    //   telemetry_events 를 "쓰는 코드가 없어도 닫는다"고 판단한 것과 같은 결이다.
    match /cost_logs/{logId} {
      allow read: if canReadProjectScopedDoc();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }

    // ===== Audit Logs (Phase 4) =====
    //
    // 불변 원장. 단, update 를 통째로 막으면 **멱등 재시도가 불가능**해진다.
    //
    // L1(#522)은 ack 만 유실된 쓰기를 재시도해도 중복 문서가 생기지 않도록 문서 id
    // 를 로컬에서 1회 생성해 setDoc 으로 재사용한다. 그런데 첫 시도가 실제로는
    // 서버에 닿았고 ack 만 유실된 경우, 같은 id 로의 재시도는 Firestore 가 update
    // 로 판정한다 → `update: if false` 에 걸려 permission-denied → 스풀이 그 레코드
    // 에서 영원히 고착한다(실측: 1s/2s/4s/9s/24s 백오프마다 PERMISSION_DENIED 반복).
    //
    // ★그래서 "동일 내용 재쓰기"만 허용한다. 어떤 필드도 바뀔 수 없으므로 불변성은
    // 그대로다 — 관측 가능한 상태 변화가 원천적으로 불가능한 no-op 만 통과한다.
    // 불변성과 멱등 재시도는 모순이 아니다: 모순처럼 보인 건 "동일 내용의 재확인"을
    // "변경"과 같은 범주로 취급했기 때문이다.
    //
    // 성립 조건: 재시도 페이로드가 결정적으로 동일해야 한다. L1 이 createdAt 을
    // serverTimestamp 가 아니라 Timestamp.fromMillis(occurredAtMs) 로 쓰기 때문에
    // 성립한다. ★이후 이 컬렉션에 서버 생성 값(serverTimestamp/request.time 등)을
    // 추가하면 이 등식이 깨져 고착이 되살아난다.
    //
    // ★L2 read 스코프 (크로스테넌트 격리): 이전엔 isAuthenticated() 만 검사해
    // 로그인한 누구나 타 테넌트 감사 기록을 읽었다. canReadLedgerDoc() 으로
    // 프로젝트 멤버(정상 레코드) / 플랫폼 admin(projectId="" 유실 마커)만 읽게
    // 조인다. create/update(L1.6 멱등 재시도)/delete 는 건드리지 않는다 —
    // update 규칙을 되돌리면 스풀 고착(L1.6 회귀)이 되살아난다.
    // ★`params` 노출 범위 — 유지한다. 근거 (티켓 Ciriq5ASEvAlA8TnKxhW):
    //
    //   문제는 실재한다. `params` 는 툴 인자 **원문**이라 지시문·경로·자격증명이
    //   섞일 수 있는데(ledger.ts 가 `params: input.params` 로 그대로 쓴다 —
    //   대조적으로 `instruction` 은 instructionHash + instructionRedacted 로 이미
    //   해시·스크럽된다), read 게이트는 `isProjectMember` 라 **프로젝트 멤버 누구나
    //   직접 쿼리로 원문을 읽는다.** 감사 콜러블이 아무리 잘 걸러도 클라이언트가
    //   원본을 직접 읽으면 소용없다 — "멤버가 남의 이력을 못 본다"는 콜러블
    //   수준에서만 참이고 플랫폼 수준에선 거짓이다.
    //
    //   그런데 **룰로는 못 고친다.** Firestore 에는 필드 단위 read 게이팅이 없다.
    //   컬렉션을 통째로 owner/admin 으로 조이는 선택지는 있지만 그러면
    //   ActivityStreamPanel(일반 멤버의 액티비티 스트림)이 통째로 죽는다 —
    //   projectAuditLog 블록 주석이 설명하는 바로 그 트레이드오프이고, 이 티켓의
    //   완료 기준은 "앱 기존 경로 회귀 0" 이다. 한 컬렉션을 필드별로 다른 등급으로
    //   게이팅하는 것도 불가하다(쿼리 결과의 모든 문서가 통과해야 쿼리가 허용됨 —
    //   #406/#428 에서 겪은 실패 모드).
    //
    //   ★그래서 올바른 수정 지점은 read 룰이 아니라 **write 쪽**이다: `instruction`
    //   이 이미 하고 있듯 `params` 를 기록 시점에 스크럽/화이트리스트하면 원문이
    //   애초에 원장에 남지 않는다. 그건 이 티켓의 범위 밖(읽기 경로 전용)이라
    //   손대지 않고 별건으로 보고한다. 여기서 어설프게 조이면 회귀만 만들고
    //   원문은 여전히 문서 안에 남는다 — 노출 범위를 줄인 것처럼 보이지만
    //   실제로는 아무것도 못 지운다.
    //
    //   현 상태의 정확한 서술: `params` 원문은 **프로젝트 멤버 경계까지** 노출된다.
    //   크로스테넌트는 닫혀 있고(L2), 프로젝트 내부에서는 열려 있다.
    match /audit_logs/{logId} {
      allow read: if canReadLedgerDoc();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated()
        && request.resource.data == resource.data;
      allow delete: if false;
    }

    // ===== Ledger Checkpoints (L3 머클 체크포인트) =====
    // 그 시점 모든 체인 머리를 머클 루트 하나로 봉인한 명부. 메인 프로세스가
    // 주기적으로 쓴다(electron/ledger-checkpointer.ts). 체인 통째 삭제는 이
    // 명부와 대조해야만 탐지된다 — 체인이 사라지면 체인 내부 검증에는 검증할
    // 대상 자체가 남지 않기 때문이다(설계 §6 표 아래 칸).
    //
    // read: audit_logs 와 같은 게이트(canReadLedgerDoc). 체크포인트만 따로 열면
    //   타 테넌트의 에이전트 id·활동량이 명부로 새어나간다 — 원장 본문을 막아
    //   놓고 목차를 여는 셈이다.
    // create: isAuthenticated. 쓰는 쪽이 **메인 프로세스**라 여기를 멤버 스코프로
    //   조이면 #406 이 그대로 재현된다(메인의 인증 경로는 렌더러와 다르다).
    //   L2 가 audit_logs create 를 열어 둔 것과 같은 판단이며, 위조 체크포인트를
    //   끼워 넣어도 prevCheckpointHash 사슬이 어긋나 검증에서 드러난다 —
    //   무결성은 룰이 아니라 해시가 보증한다.
    // ★update/delete: 금지. 체크포인트는 봉인이므로 고칠 수 있으면 봉인이 아니다.
    //   audit_logs 와 달리 no-op update 도 허용하지 않는다 — 체크포인트 쓰기는
    //   `${projectId}_${seqNo}` 결정적 id 로 1회만 일어나고 스풀 재시도 경로를
    //   타지 않아서, L1.6 고착을 부르는 멱등 재시도 요구가 없다.
    match /ledger_checkpoints/{checkpointId} {
      allow read: if canReadLedgerDoc();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }

    // ===== Project Audit Log (협업 구성원 행위 감사) =====
    // 렌더러(사람)발 행위를 projectId + actorUid 로 귀속 기록한다
    // (src/services/projectAuditService.ts). `audit_logs` 원장과 **다른
    // 컬렉션인 이유는 접근등급이 다르기 때문**이다:
    //   - audit_logs      = MCP 툴 호출(AI 행위). read = 프로젝트 멤버 전원
    //                       (canReadLedgerDoc) — ActivityStreamPanel 이 소비.
    //   - projectAuditLog = 사람 행위 감사. read = **owner/admin 전용.**
    // 하나로 합치면 둘 중 하나가 반드시 깨진다: audit_logs 를 admin 전용으로
    // 조이면 일반 멤버의 액티비티 스트림이 죽고, 반대로 이 컬렉션을 멤버 read 로
    // 열면 "관리자만 감사 조회" 요구가 깨진다. 한 컬렉션을 필드별로 다른 등급으로
    // 게이팅하는 것도 불가 — Firestore 는 쿼리 결과의 모든 문서가 통과해야
    // 쿼리를 허용하므로 클라이언트 제약이 룰 분기와 어긋나는 순간 쿼리 전체가
    // permission-denied 로 죽는다(#406/#428 에서 겪은 실패 모드).
    //
    // read: isAdminOrOwner 재사용(owner 또는 memberRoles 의 admin).
    // create: 멤버 누구나 **자기 행위만** 기록할 수 있다. 감사 대상이 곧 writer
    //   라는 구조상 불가피한 부분 — 그래서 actorUid == request.auth.uid 로
    //   사칭을 막는다(남의 이름으로 기록 불가). 기록을 **생략**하는 것까지는
    //   클라이언트 캡처로 막을 수 없다(서비스 파일 상단 "신뢰 경계" 주석 참조).
    // update/delete: 금지 — append-only. 감사 로그를 사후에 고칠 수 있으면
    //   감사가 아니다. owner/admin 도 예외 없다.
    match /projectAuditLog/{eventId} {
      allow read: if isAuthenticated()
        && isAdminOrOwner(resource.data.projectId);
      allow create: if isAuthenticated()
        && isProjectMember(request.resource.data.projectId)
        && request.resource.data.actorUid == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // ===== Merge History (worktree audit trail) =====
    // Append-only record of completed (squash-merged) worktrees. Written by the
    // Electron main process at the merge chokepoint; read by the cockpit's
    // "완료 이력" view. Immutable, same posture as audit_logs.
    //
    // ★L2 read 스코프: canReadLedgerDoc() 으로 프로젝트 멤버만 읽게 조인다.
    //   main 이 실 projectId 로만 write 하므로 projectId="" 마커는 없지만 게이트는
    //   공통으로 둔다(방어).
    // ★★배포 전 필수 선행(프론트): 코크핏의 크로스프로젝트 뷰
    //   (WorktreeTab / WorkHistoryTab)가 subscribeToMergeHistory 를 projectId
    //   없이(unscoped orderBy) 구독한다. 멤버 스코프 룰 하에서는 Firestore 가
    //   비멤버 문서를 포함할 수 있는 unscoped 쿼리를 permission-denied 로 통째
    //   거부한다 → 룰만 먼저 배포하면 코크핏 완료이력/워크트리 탭이 라이브에서
    //   죽는다(#406/#428 재현). 반드시 프론트 쿼리를 멤버 프로젝트로 스코프한 뒤
    //   (mergeHistoryService 의 projectIds 옵션) 함께 배포한다.
    match /merge_history/{mergeId} {
      allow read: if canReadLedgerDoc();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }

    // ===== Telemetry Events =====
    // ★L2 read 스코프: canReadLedgerDoc(). 현재 이 Firestore 컬렉션을 쓰거나 읽는
    //   코드 경로는 없다(런타임 텔레메트리는 렌더러 choke → functions → BigQuery
    //   로 감). 그래도 다른 원장 계열과 동일하게 멤버 스코프로 닫아 로그인만으로
    //   과거/잔존 문서를 크로스테넌트로 읽는 구멍을 없앤다.
    match /telemetry_events/{eventId} {
      allow read: if canReadLedgerDoc();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }

    // ===== Invitations =====
    match /invitations/{invitationId} {
      // Anyone authenticated can read invitations targeted to their email
      allow read: if isAuthenticated()
        && (isProjectMember(resource.data.projectId)
            || resource.data.invitedEmail == request.auth.token.email);

      // Only admin+ of the project can create invitations
      allow create: if isAuthenticated()
        && isAdminOrOwner(request.resource.data.projectId)
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.status == 'pending';

      // The invited user can accept/reject, project admin+ can cancel (update status)
      // B2 하드닝: 초대 대상자는 status 필드만 바꿀 수 있다(role/projectId 조작
      // 차단). 'expired' 는 acceptInvitation 이 만료 초대를 정리하는 전이.
      // 이메일 비교는 대소문자 무시 — invitedEmail 은 소문자 정규화로 저장된다.
      allow update: if isAuthenticated()
        && (
          // Invited user accepting or rejecting
          (resource.data.invitedEmail.lower() == request.auth.token.email.lower()
           && resource.data.status == 'pending'
           && request.resource.data.status in ['accepted', 'rejected', 'expired']
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
          ||
          // Admin/owner updating (e.g., expire)
          isAdminOrOwner(resource.data.projectId)
        );

      // Admin+ can delete (cancel) pending invitations
      allow delete: if isAuthenticated()
        && isAdminOrOwner(resource.data.projectId);
    }

    // ===== Presence (B3: 프로젝트 접속 표시) =====
    // presence/{projectId}/users/{userId} — collaborationService.updatePresence
    // 가 주기적으로 setDoc 하고 subscribeToPresence(PresenceIndicator)가 구독.
    // 이전엔 match 자체가 없어 기본 거부였다. 멤버끼리만 서로 보이고,
    // 쓰기는 본인 문서만(userId 필드 위조 동시 차단).
    match /presence/{projectId}/users/{userId} {
      allow read: if isAuthenticated() && isProjectMember(projectId);
      allow create, update: if isAuthenticated()
        && isOwner(userId)
        && isProjectMember(projectId)
        && request.resource.data.userId == userId;
      // 본인 문서 정리는 멤버 탈퇴 후에도 가능해야 하므로 멤버십을 요구하지 않는다.
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    // ===== Member Roles =====
    // Document ID format: {projectId}_{userId}
    //
    // ★docId ↔ 본문 결속: isAdminOrOwner()/getMemberRole() 은 docId 규약으로
    //   문서를 get 하는데, 이전 룰은 "본문 projectId 의 admin 이면 아무 docId 로나
    //   생성"을 허용했다 → A 프로젝트 admin 이 docId="B_자기uid" + 본문
    //   projectId=A 로 위조 문서를 만들어 B 프로젝트 admin 권한을 얻는
    //   크로스프로젝트 권한상승 구멍. docId == {본문 projectId}_{본문 userId} 를
    //   강제해 닫는다(update 시 projectId/userId 불변 포함).
    // ★admin 승격/강등은 owner 전용: "admin=owner 가 지정". admin 은 member/
    //   viewer role 만 만들고 바꿀 수 있으며, admin role 문서의 생성·변경·삭제
    //   (삭제=사실상 member 로 강등)는 owner 만 가능하다.
    function memberRoleDocIdMatches(docId) {
      return docId == request.resource.data.projectId + '_' + request.resource.data.userId;
    }

    match /memberRoles/{docId} {
      allow read: if isAuthenticated()
        && isProjectMember(resource.data.projectId);

      allow create: if isAuthenticated()
        && memberRoleDocIdMatches(docId)
        && isAdminOrOwner(request.resource.data.projectId)
        && request.resource.data.role != 'owner'
        && (request.resource.data.role != 'admin'
            || isProjectOwner(request.resource.data.projectId));

      allow update: if isAuthenticated()
        && memberRoleDocIdMatches(docId)
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.userId == resource.data.userId
        && isAdminOrOwner(resource.data.projectId)
        && request.resource.data.role != 'owner'
        && ((request.resource.data.role != 'admin'
             && resource.data.get('role', '') != 'admin')
            || isProjectOwner(resource.data.projectId));

      allow delete: if isAuthenticated()
        && isAdminOrOwner(resource.data.projectId)
        && (resource.data.get('role', '') != 'admin'
            || isProjectOwner(resource.data.projectId));
    }

    // ===== Subscriptions =====
    // Document ID = userId
    match /subscriptions/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if false; // Only Cloud Functions can write
    }

    // ===== Coupons =====
    // Coupon lifecycle and redemption records are managed exclusively through
    // Cloud Functions/Admin SDK. Clients must use validateCoupon/applyCoupon
    // callables instead of reading or mutating these collections directly.
    match /coupons/{couponCode} {
      allow read, write: if false;
    }

    match /couponRedemptions/{redemptionId} {
      allow read, write: if false;
    }

    // ===== Lectures (marblo-web sales site) =====
    match /lectures/{lectureId} {
      allow read: if true; // Public: anyone can browse published lectures
      allow write: if false; // Only Cloud Functions / admin can write
    }

    // ===== Lecture Purchases =====
    match /lecturePurchases/{purchaseId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow create: if false; // Only Cloud Functions can create
      allow update, delete: if false;
    }

    // ===== Lecture Progress (시청 진도 이어보기) =====
    // 본인 문서만 read/write. 문서 = (userId, lectureSlug, youtubeId) 진도.
    // 클라이언트가 직접 setDoc(merge) 하되 userId 위조를 차단한다.
    match /lectures_progress/{progressId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ===== Beta Tester 50 Waitlist (marblo-web public signup) =====
    // Unauthenticated visitors can sign up via marblo-web homepage form.
    // - create: strict shape + email regex; no other fields permitted
    // - list:   allowed so the page can show the live seats-left counter via
    //           getCountFromServer (aggregation query only)
    // - get:    blocked so individual emails cannot be enumerated
    // - update/delete: operators only via console (Admin SDK / IAM bypasses rules)
    match /betatester50_waitlist/{doc} {
      allow create: if request.resource.data.keys().hasOnly([
          'email', 'locale', 'source', 'agreed', 'agreedAt', 'createdAt',
          'marketingConsent', 'marketingConsentVersion', 'marketingConsentAt'
        ])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.locale in ['ko', 'en', 'ja']
        && request.resource.data.source in ['home', 'promo_bar', 'foundation50_page']
        && request.resource.data.agreed == true
        && request.resource.data.marketingConsent is bool
        && (request.resource.data.marketingConsentVersion is string
          || request.resource.data.marketingConsentVersion == null)
        && (request.resource.data.marketingConsentAt is timestamp
          || request.resource.data.marketingConsentAt == null);
      // 읽기는 전면 차단(로그인 누구나 이메일을 list 로 열람하던 홀 차단).
      // 좌석 카운트는 공개 함수 getWaitlistCount, 어드민 신청목록은
      // getFounderWaitlist 등 Cloud Functions(admin SDK) 경유로만 노출한다.
      allow list: if false;
      allow get: if false;
      allow update, delete: if false;
    }

    // ===== Founders (파운더 100인 무료 베타 선정/상태) =====
    // Document ID = normalized email. 선정·피드백·인터뷰 상태와 Pro 부여 기록.
    // 전적으로 Cloud Functions(Admin SDK, 규칙 우회)로만 기록한다.
    // 클라이언트 직접 접근 차단 — 상태 확인/제출은 callable 함수 경유.
    match /founders/{email} {
      allow read, write: if false;
    }

    // ===== Founder Feedback (V2 7문항 설문 + 운영자 루브릭 채점) =====
    // Cloud Functions(Admin SDK)가 정식 제출/채점 경로다. 직접 클라이언트 접근은
    // 방어선으로만 제한한다: 사용자는 자기 설문만, 루브릭/선정/보상은 어드민만.
    match /founder_feedback/{feedbackId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isPlatformAdmin());
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId',
          'email',
          'locale',
          'answers',
          'betaExpiresAt',
          'createdAt'
        ])
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.locale in ['ko', 'en', 'ja']
        && request.resource.data.answers is map
        && request.resource.data.answers.keys().hasOnly([
          'q1', 'q2', 'q3', 'q4', 'q5', 'q6', 'q7'
        ])
        && request.resource.data.answers.q1 is string
        && request.resource.data.answers.q2 is string
        && request.resource.data.answers.q3 is string
        && request.resource.data.answers.q4 is string
        && request.resource.data.answers.q5 is string
        && request.resource.data.answers.q6 is string
        && request.resource.data.answers.q7 is string;
      allow update: if isPlatformAdmin()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.email == resource.data.email;
      allow delete: if false;
    }

    // ===== Bug Reports (인앱 사용자 버그 신고) =====
    // 앱은 submitBugReport 콜러블(Admin SDK) 경유로 제출 — 서버가 uid/email/
    // createdAt 을 각인하고 입력을 검증한다. 아래 규칙은 방어선:
    //  - read: 본인 신고만. 어드민 트리아지는 listBugReports 콜러블로 조회.
    //  - create: 금지 — 제출은 submitBugReport 콜러블(Admin SDK, rules 우회)만.
    //    클라 직접 쓰기를 막아 임의 uid 각인/스키마 위조/스팸 주입을 차단한다.
    //  - update/delete: 금지 — status 변경은 updateBugReportStatus(어드민) 경로.
    match /bugReports/{reportId} {
      allow read: if isAuthenticated()
        && resource.data.uid == request.auth.uid;
      allow create: if false;
      allow update, delete: if false;
    }

    // submitBugReport 의 rate-guard 가 쓰는 throttle 문서 — 전적으로 Cloud
    // Functions(Admin SDK)로만 read/write. 클라이언트 직접 접근 차단.
    match /bugReportThrottle/{uid} {
      allow read, write: if false;
    }

    // ===== Marketing Contacts (이메일 마케팅 SoT) =====
    // 암호화 이메일·수신동의·unsubscribe 상태. 전적으로 Cloud Functions
    // (Admin SDK, 규칙 우회) 전용 — 클라이언트 직접 접근 전면 차단.
    // consent_events 는 동의/철회 감사로그(append-only, 역시 서버 전용).
    match /marketing_contacts/{contactId} {
      allow read, write: if false;
      match /consent_events/{eventId} {
        allow read, write: if false;
      }
    }

    // ===== Push Tokens (푸시 마케팅 — 현재는 스키마 예약만, 적재는 후속) =====
    // uid·deviceId·tokenHash·pushMarketingConsent. 서버 전용.
    match /push_tokens/{tokenId} {
      allow read, write: if false;
    }

    // ===== Public Mission Replay (공개 Replay — 유일한 anon read 표면) =====
    //
    // 설계 단일소스: docs/MISSION-REPLAY-DESIGN.md §7.1 · §5.7 F6.
    //
    // ★이 앱에서 **미인증 사용자가 읽을 수 있는 유일한 컬렉션**이다. 그래서
    //   나머지 룰보다 좁게 쓴다. 두 문서로 쪼갠 이유:
    //
    //   publicReplays/{replayId}      = 공개. 비식별판 payload + 등급 + 발행시각.
    //                                   **내부 식별자가 하나도 없다** (projectId·
    //                                   missionId·uid 전부 없음). 비식별화 엔진이
    //                                   payload 안의 id 를 다 지워 놓고 문서 봉투에
    //                                   원본 id 를 적으면 아무 의미가 없다(R16/R2b).
    //   publicReplayOwners/{replayId} = 비공개 소유권 인덱스. 룰의 write 판정 근거
    //                                   이자 앱의 발행 목록. 프로젝트 멤버만 read.
    //
    // ★fail-closed 세 겹 (F6 — 해제 후 캐시 잔존 + id 열거로 취소본 접근):
    //   1) replayId 가 130비트 crypto 난수다(services/publicReplayService).
    //   2) `allow list: if false` — 컬렉션 열거 자체가 불가능하다. get 만 된다.
    //   3) read 는 status == 'published' 인 문서만. 문서가 없으면(=해제됨) 룰이
    //      거부로 떨어지므로 "존재하지만 비공개" 와 "없음" 을 구분해 주지 않는다.
    //
    // ★공개 문서는 **불변**이다(update: if false). 이미 공유된 URL 의 내용이
    //   나중에 바뀌면 L1 로 공유한 링크가 조용히 L3 가 될 수 있다. 등급 변경은
    //   해제 후 **새 replayId 로 재발행**이다 — 옛 링크는 죽는다.
    //
    // ★정직한 한계: 룰은 "이 바이트가 비식별화을 통과했는가"를 알 수 없다.
    //   그건 기기에서 끝난다(설계 불변식). 룰이 강제하는 것은 필드 allowlist·
    //   등급 enum·크기 상한·상태값·소유권까지다. 사용자당 발행 수 상한과
    //   레이트리밋(§7.3)은 후속 functions 티켓이다.

    function publicReplayOwnerExists(replayId) {
      return exists(/databases/$(database)/documents/publicReplayOwners/$(replayId));
    }

    function publicReplayOwnerDoc(replayId) {
      return get(/databases/$(database)/documents/publicReplayOwners/$(replayId)).data;
    }

    // 공개 문서를 만들거나 지울 수 있는 주체 = 소유권 문서가 가리키는 프로젝트의
    // owner/admin (Q4). 소유권 문서가 없으면 판정 근거가 없으므로 거부한다.
    function canManagePublicReplay(replayId) {
      return isAuthenticated()
        && publicReplayOwnerExists(replayId)
        && isAdminOrOwner(publicReplayOwnerDoc(replayId).projectId);
    }

    // payload 상한 512000자 = services/publicReplayService.ts 의
    // PUBLIC_REPLAY_MAX_PAYLOAD_CHARS 와 같은 수. 클라이언트에만 두면 패치된
    // 클라이언트가 Firestore 1MiB 한도까지 밀어 넣는다.
    function isValidPublicReplayDoc() {
      return request.resource.data.keys().hasOnly(
          ['schemaVersion', 'replayVersion', 'level', 'status', 'payload', 'publishedAt'])
        && request.resource.data.keys().hasAll(
          ['schemaVersion', 'replayVersion', 'level', 'status', 'payload', 'publishedAt'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.replayVersion == 1
        && request.resource.data.level in ['L1', 'L2', 'L3']
        && request.resource.data.status == 'published'
        && request.resource.data.payload is string
        && request.resource.data.payload.size() > 0
        && request.resource.data.payload.size() <= 512000
        && request.resource.data.publishedAt is timestamp;
    }

    // ===== 팀 오버뷰 캐시 — ★서버 전용 티어 (#1103 설계 §5.5/§6.2) =====
    //
    // ★클라가 이걸 직접 읽으면 `getTeamUsageSummary` 콜러블의 역할 게이트(오너/
    //   admin 만 팀 분해)를 **통째로 우회**한다. 캐시 문서에는 프로젝트 전체의
    //   멤버별 숫자가 들어 있으므로, 읽기를 여는 것은 곧 일반 멤버에게 남의
    //   사용량을 여는 것이다 — 그건 팀 기능이 아니라 감시다.
    //
    // ★Admin SDK 는 이 규칙을 **우회한다.** 그래서 서버는 그대로 읽고 쓰고,
    //   권한 판정은 콜러블 안에서 서버 코드가 스스로 한다(룰에 기대지 않는다).
    //
    // ★#1096 의 `projects` 필드별 allowlist 를 한 글자도 늘리지 않는다 —
    //   캐시를 별도 컬렉션에 둔 이유가 그것이다. 룰 표면 증가는 0 이다.
    //
    // 문서 id 규약: `{projectId}__{windowKey}` (teamUsage.buildTeamUsageCacheDocId).
    // 만료는 Firestore TTL 정책이 `expiresAt` 필드로 지운다.
    match /teamUsageCache/{docId} {
      allow read, write: if false;
    }

    match /publicReplays/{replayId} {
      // 미인증 read 허용 — 단 발행된 문서 1건 get 만. 열거는 막는다.
      allow get: if resource.data.get('status', '') == 'published';
      allow list: if false;

      allow create: if canManagePublicReplay(replayId)
        && isValidPublicReplayDoc()
        // 소유권 문서가 published 상태이고 등급이 일치해야 한다. 해제된 id 를
        // 되살려 다시 공개하는 경로를 닫는다(해제는 되돌릴 수 없다).
        && publicReplayOwnerDoc(replayId).status == 'published'
        && publicReplayOwnerDoc(replayId).level == request.resource.data.level;
      allow update: if false;
      allow delete: if canManagePublicReplay(replayId);
    }

    match /publicReplayOwners/{replayId} {
      // 발행 이력은 프로젝트 내부 정보다(해제분 포함). 멤버만 읽는다.
      allow read: if isAuthenticated()
        && isProjectMember(resource.data.projectId);

      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'replayId', 'projectId', 'missionId', 'publisherUid', 'level',
          'includeCost', 'status', 'publishedAt', 'unpublishedAt'
        ])
        && request.resource.data.replayId == replayId
        && request.resource.data.publisherUid == request.auth.uid
        && request.resource.data.status == 'published'
        && request.resource.data.level in ['L1', 'L2', 'L3']
        && request.resource.data.publishedAt is timestamp
        && isAdminOrOwner(request.resource.data.projectId);

      // 허용되는 전이는 published → unpublished **한 방향뿐**이다. 되살리기를
      // 룰에서 막아 두면, 해제된 URL 이 다시 살아나는 경로가 존재하지 않는다.
      allow update: if isAuthenticated()
        && isAdminOrOwner(resource.data.projectId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'unpublishedAt'])
        && resource.data.status == 'published'
        && request.resource.data.status == 'unpublished';

      // 삭제 금지 — 발행했다는 사실 자체가 감사 기록이다(캐시 잔존 경고를
      // 나중에도 사용자에게 보여줄 수 있어야 한다).
      allow delete: if false;
    }
  }
}
