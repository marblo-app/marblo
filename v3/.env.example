# ================================
# Marblo v3 Environment Variables
# ================================

# Firebase Configuration (Firebase Console > Project Settings > Web App)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ================================
# First-party 텔레메트리 (Firebase Functions → BigQuery)
# ================================
# 기본 ON (실사용자 포함, 2026-07-17 CEO 승인). lib/telemetry/firstPartyGate.ts 가
# 단일 진실원 — 비식별 1차 집계(익명 install id, PII scrub)만 기기 밖으로 나간다.
# 사용자는 런타임 setTelemetryEnabled(false) 로 옵트아웃할 수 있고, 3rd-party 공유는
# 여전히 별도 옵트인이다.
#
# 과거 빌드시점 플래그 VITE_FIRST_PARTY_TELEMETRY(도그푸드 opt-in)는 PR#397 로 게이트가
# default-ON 이 되면서 더 이상 아무것도 게이트하지 않는다(=no-op, 폐기). 상세: docs/telemetry-build-profiles.md
#
# VITE_DISABLE_TELEMETRY=1 은 모든 것을 이기는 하드 kill-switch (외부 빌드에서 강제 OFF 시 사용).
# VITE_DISABLE_TELEMETRY=1

# Packaged-app Google 로그인 B안(시스템 브라우저 loopback OAuth) — Optional.
# 미설정 시 기존 signInWithRedirect(A안) 경로로 폴백한다. 활성화·검증 절차는
# docs/GOOGLE_LOGIN_PACKAGED.md 참고.
# - CLIENT_ID 는 VITE_ 프리픽스라 렌더러(게이팅/에러 메시지)도 읽는다. 공개
#   식별자라 노출돼도 무방하며, main 프로세스도 dotenv 로 process.env 에서 읽는다.
# - CLIENT_SECRET 은 VITE_ 프리픽스가 아니라 렌더러 번들에 인라인되지 않고 main
#   프로세스(토큰 교환)만 사용한다. RFC 8252: 데스크톱 앱에선 비밀이 아니지만
#   Google "Desktop app" 클라이언트는 토큰 엔드포인트에서 이 값을 요구한다.
# VITE_GOOGLE_DESKTOP_OAUTH_CLIENT_ID=<desktop-client-id>.apps.googleusercontent.com
# GOOGLE_DESKTOP_OAUTH_CLIENT_SECRET=<desktop-client-secret>

# LLM API Keys (Optional - can also set in app Settings > API Keys)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_AI_API_KEY=AI...

# ================================
# env-swap 벤더 크레덴셜 (provider ≠ harness, model-registry 의 envProfile)
# ================================
# ★신규 CLI 를 설치하지 않는 벤더다 — 우리 `claude` 바이너리에 env 만 갈아끼워
# 그 벤더 백엔드로 붙인다. 레지스트리엔 **키 이름**만 있고 값은 여기서만 온다.
#
# Z.ai GLM Coding Plan (glm-5.2 / glm-4.7). z.ai 구독 후 Open Platform >
# API Keys 에서 발급. 미설정 시: 스폰은 되지만 벤더 프로파일이 통째로
# 미주입되고(부분 주입 금지 — 우리 Anthropic 토큰이 남의 엔드포인트로 나가는 것을
# 막는다) 경고 한 줄이 남는다. 설정 후 앱 재시작 필요(dotenv 는 부팅 때 1회).
# 확인: npm run verify:models  (키 이름만 출력, 값은 절대 안 찍는다)
# ZAI_API_KEY=
#
# MiniMax Token Plan (MiniMax-M3 / MiniMax-M2.7). platform.minimax.io 구독 후
# User Center > Token Plan 에서 Subscription Key 발급(sk-cp-… 형태). 미설정 시
# 동작은 위 ZAI_API_KEY 와 같다(프로파일 통째 미주입 + 경고 한 줄).
# ★international 엔드포인트(api.minimax.io) 기준이다 — 중국 플랫폼
# (platform.minimaxi.com)의 키는 계정 자체가 달라 여기 넣어도 안 통한다.
# MINIMAX_API_KEY=
#
# Upstage Solar Pro 4 (solar-pro4). console.upstage.ai/api-keys. OpenAI 호환 base_url=https://api.upstage.ai/v1. 스폰 전용(오케 아님).
# UPSTAGE_API_KEY=
#
# DeepSeek V3/R1 (deepseek-chat / deepseek-reasoner). platform.deepseek.com. OpenAI 호환 base_url=https://api.deepseek.com/v1. 스폰 전용(오케 아님).
# DEEPSEEK_API_KEY=

# Paddle (International payments - vendors.paddle.com)
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENVIRONMENT=sandbox
VITE_PADDLE_PRO_PRICE_ID=
VITE_PADDLE_TEAM_PRICE_ID=

# TossPayments (Korean payments - developers.tosspayments.com)
VITE_TOSS_CLIENT_KEY=

# Sentry (crash / runtime-error / release-stability capture) — Optional.
# 미설정(빈 값) 시 Sentry 는 완전 no-op: 동의를 켜도 init 하지 않는다(회귀 안전,
# PIPA). 값이 있어야만, 그리고 사용자가 개인정보 설정에서 Sentry 동의를 켠 경우에만
# @sentry/electron(main+renderer) 이 실제 init 된다. 모든 이벤트는 전송 전
# beforeSend 스크러버(파일경로/이메일/키/유저입력 제거)를 통과한다.
# DSN 은 사용자 제공 시크릿 — 커밋 금지. Sentry 프로젝트 생성 후 주입한다.
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# 이벤트 environment 라벨 override(선택). 기본: PROD 빌드=production, 그 외=development.
# VITE_SENTRY_ENVIRONMENT=production

# ================================
# 모델 스폰 정책 (SPAWN-MODEL-ALLOCATION-V2)
# 모두 선택(Optional). 미설정 시 아래 "기본" 동작.
# 난이도(complexity)별로만 적용: complex=어려움, standard=보통, simple=쉬움.
# ================================

# ── 어려운(complex) 작업의 최상위 Claude 모델 ──
# 기본: fable (→ claude-fable-5, 최신 Claude 5 계열 "최신 하이 모델").
# 단, 아래 MARBLO_FABLE5_MIN_CLI 버전가드를 통과하는 CLI 에서만 fable5 로 스폰되고
# 미달이면 opus 로 자동 폴백(로그 남김). opus 로 고정하려면 값을 opus 로.
# ★complex 티어에만 영향 — standard 는 항상 opus, simple 은 아래 SIMPLE 값.
# MARBLO_TOP_CLAUDE_MODEL=fable
# Fable5 를 허용하는 claude CLI 최소 버전(버전가드 임계값). 기본 2.1.170.
# MARBLO_FABLE5_MIN_CLI=2.1.170
# 어려운 작업의 Codex reasoning effort. 기본 high (low/medium/high).
# MARBLO_TOP_CODEX_REASONING=high

# ── 쉬운(simple) 작업의 cheap 모델 ──
# simple 물리스폰(isolate=true)에서 쓰는 저비용 Claude 모델. 기본 sonnet.
# MARBLO_SIMPLE_CLAUDE_MODEL=sonnet
# simple 작업의 Codex reasoning effort. 기본 low (low/medium/high).
# MARBLO_SIMPLE_CODEX_REASONING=low

# ── usage 기반 자동 모델 믹스 (§B, 기본 OFF) ──
# 켜면(1/true/on/yes) complex 작업에서 Codex·Claude 가 둘 다 연결돼 있고 전체
# usage 에 여유가 있을 때 자동으로 Codex 교차검증 믹스를 걸고, 한쪽이 소진 임박
# 이면 반대 모델로 1차 라우팅한다. 명시적 mix 요청/명시적 model 지정은 존중.
# MARBLO_AUTO_MIX=off
# 자동 믹스 판정 임계값(사용률 %). headroom 미만=여유, exhaust 이상=소진 임박.
# MARBLO_MIX_HEADROOM_PCT=80
# MARBLO_MIX_EXHAUST_PCT=90
