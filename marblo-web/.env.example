# GA4 measurement ID (G-XXXXXXXXXX). Empty = analytics no-op (safe for builds).
# Get it from GA4 console → data stream, then set in .env.local / hosting env.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Canonical site origin for SEO URLs (no trailing slash, no www).
# NOTE: the live value is the SITE_URL constant in src/lib/seo.ts (single
# source of truth); this entry documents that origin. It is not read at runtime
# unless seo.ts is wired to fall back to it.
NEXT_PUBLIC_SITE_URL=https://marblo.app

# Google Search Console ownership verification token (the content value of the
# `google-site-verification` meta tag). Empty = no meta tag emitted.
# Get it from Search Console → Settings → Ownership verification → HTML tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Naver Search Advisor ownership verification token (the content value of the
# `naver-site-verification` meta tag).
# Get it from Naver Search Advisor (searchadvisor.naver.com) → 사이트 등록 → HTML 태그.
# NOTE: if unset, the code falls back to the current public Naver token hardcoded
# in src/app/[locale]/layout.tsx (public value, not a secret), so the meta tag
# always renders. Set this only to override with a different token.
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
