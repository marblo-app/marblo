# Production env for marblo-web builds (loaded by `next build`).
# GA4 measurement ID is a PUBLIC value (rendered into client HTML by the gtag
# script), so committing it here is safe and keeps the prod build self-contained
# regardless of host env config. Move to your host's env dashboard if preferred.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-YPXYS9PB0R

# Founder survey nudge popup (FounderSurveyGate). Approved for production: show
# logged-in, selected-but-未회신 founders the "설문 회신 시 Pro 최대 3개월" prompt.
# This is a PUBLIC build-time gate (only controls popup exposure — 심사·지급은
# 기존 백엔드가 그대로 처리). Build-time (NEXT_PUBLIC_*), so flipping it requires
# a rebuild/redeploy.
NEXT_PUBLIC_FOUNDER_SURVEY_PROMPT_OPEN=true
